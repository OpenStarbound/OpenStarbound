local DEFAULT_COLOR = "white"

-- Starbound chat color is an inline escape code in the text itself
-- (^colorname;...^reset;) — not a `color` option on chat.addMessage.
function colorizeText(text, color)
  return "^" .. color .. ";" .. tostring(text) .. "^reset;"
end

-- Colors each texts[i] with colors[i] and joins the results. Falls back
-- to DEFAULT_COLOR if colors is shorter than texts.
function colorizeTexts(texts, colors)
  local parts = {}
  for i, text in ipairs(texts) do
    parts[i] = colorizeText(text, colors[i] or DEFAULT_COLOR)
  end
  return table.concat(parts)
end

